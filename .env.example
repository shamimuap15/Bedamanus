# Postgres connection string (Neon: use the "pooled" connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Admin login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
# Random 32+ character string used to sign the admin session cookie
AUTH_SECRET=replace-with-a-long-random-string

# Vercel Blob token (added automatically when you connect a Blob store in Vercel)
BLOB_READ_WRITE_TOKEN=

# Local development only: store uploads in /public/uploads instead of Vercel Blob
# NEXT_PUBLIC_UPLOAD_MODE=local
